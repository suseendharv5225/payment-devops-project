pipeline{
    agent any
    environment{
        region = 'ap-south-1'
        ecr_repo = 'payment-service'
        aws_account = '985151713154'
        ecr_url = '.dkr.ecr.ap-south-1.amazonaws.com/payment-service'
        tag = "${BUILD_NUMBER}"
    }
    stages{
        stage('file validation'){
            steps{
                sh 'pwd'
                sh 'ls'
                sh 'find -name "*.tf"'
            }
        }
        stage('terraform version'){
            steps{
                sh 'terraform version'
            }
        }
        stage('fmt check'){
            steps{
                sh 'cd terraform/aws-network'
                sh 'terraform fmt --check'
                sh 'terraform init'
                sh 'terraform validate'
            }
        }
        stage('docker verify'){
            steps{
                sh 'docker --version'
            }
        }
        stage('docker login'){
            steps{
                sh '''
                set -e
                aws ecr get-login-password --region ${region}| docker login --username AWS --password-stdin ${aws_account}${ecr_url}
                echo "login successfull"
                '''
            }
        }
        stage('docker build'){
            steps{
                sh 'cd'
                sh 'cd payment-app'
                sh 'docker build payment-app/ -t "${aws_account}${ecr_url}:${tag}"'
                sh 'docker images'
                sh 'docker push "${aws_account}${ecr_url}:${tag}"'
            }
        }
        stage('variable pick'){
            steps{
                sh 'echo "${aws_account}"'
                sh 'echo "${aws_account}${ecr_url}"'
                sh 'echo "${tag}"'
            }
        }
        stage('image show'){
            steps{
            sh 'echo "${aws_account}${ecr_url}:${tag}"'
            }
        }
        stage('file check'){
            steps{
                script{
                    if [-f "payment-helm/templates/configmap.yaml"] && [-f "payment-helm/templates/deployment.yaml"] && [-f "payment-helm/templates/service.yaml"]{
                        echo "file exists"
                    }
                    else{
                        echo "Dockerfile not found"
                        exit 1
                    }
                }
            }
        }
    }
}
