pipeline{
    agent any
    stages{
        stage('file validation'){
            steps{
                sh 'pwd'
                sh 'ls'
                sh 'find -name "*.tf"'
            }
        }
        stage('terraform version'){
            steps{
                sh 'terraform version'
            }
        }
        stage('fmt check'){
            steps{
                sh 'cd terraform/aws-network'
                sh 'terraform fmt --check'
                sh 'terraform init'
                sh 'terraform validate'
            }
        }
        stage('docker verify'){
            steps{
                sh 'docker --version'
            }
        }
        stage('docker build'){
            steps{
                sh 'cd'
                sh 'cd payment-app'
		sh 'pwd'
		sh 'ls'
                sh 'docker build payment-app/ -t "v111"'
                sh 'docker images'
            }
        }
    }
}
